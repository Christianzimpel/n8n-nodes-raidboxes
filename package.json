{
  "name": "n8n-nodes-raidboxes",
  "version": "0.2.3",
  "description": "n8n community node for the Raidboxes API \u2013 manage Boxes, backups, cache, settings, subscriptions and SSH keys.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "raidboxes",
    "wordpress",
    "hosting"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Christianzimpel/n8n-nodes-raidboxes",
  "author": {
    "name": "Christian Zimpel",
    "email": "mail@christianzimpel.de"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Christianzimpel/n8n-nodes-raidboxes.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials package.json",
    "test": "npm run build && node test/mock-test.js"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/RaidboxesApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Raidboxes/Raidboxes.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "n8n-workflow": "*",
    "typescript": "~5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
